<idea-plugin>
    <id>com.varlanv.zigrawr</id>
    <name>ZigRawr</name>
    <vendor>varlanv</vendor>
    <description>Zig language support. todotofill40charsrequirement</description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends optional="true" config-file="com.varlanv.zigrawr-clion.xml">com.intellij.clion</depends>
    <applicationListeners>
        <listener class="com.zigrawr.jbplugin.highlight.ZigColorSchemeListener"
                  topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>
    <extensions defaultExtensionNs="com.intellij">
        <annotator language="Zig" implementationClass="com.zigrawr.jbplugin.highlight.ZigSemanticAnnotator"/>
        <colorSettingsPage implementation="com.zigrawr.jbplugin.highlight.ZigColorSettingsPage"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/ZigDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/ZigDarcula.xml"/>
        <configurationType implementation="com.zigrawr.jbplugin.run.ZigRunConfigurationType"/>
        <runConfigurationProducer implementation="com.zigrawr.jbplugin.run.ZigRunConfigurationProducer"/>
        <runConfigurationProducer implementation="com.zigrawr.jbplugin.run.ZigFileTestsConfigurationProducer"/>
        <runLineMarkerContributor language="Zig" implementationClass="com.zigrawr.jbplugin.run.ZigRunLineMarkerContributor"/>
        <programRunner implementation="com.zigrawr.jbplugin.run.ZigProgramRunner"/>
        <projectConfigurable parentId="language" id="com.zigrawr.toolchain" displayName="Zig Rawr"
                             instance="com.zigrawr.jbplugin.toolchain.ZigToolchainConfigurable"/>
        <additionalLibraryRootsProvider implementation="com.zigrawr.jbplugin.toolchain.ZigLibraryRootsProvider"/>
        <postStartupActivity implementation="com.zigrawr.jbplugin.toolchain.ZigToolchainStartupActivity"/>
        <platform.backend.documentation.targetProvider implementation="com.zigrawr.jbplugin.documentation.ZigDocumentationProvider"/>
        <highlightUsagesHandlerFactory implementation="com.zigrawr.jbplugin.highlight.ZigHighlightUsagesHandlerFactory"/>
        <gotoDeclarationHandler implementation="com.zigrawr.jbplugin.declaration.ZigDeclarationHandler"/>
        <extendWordSelectionHandler implementation="com.zigrawr.jbplugin.selection.ZigSelectionHandler"/>
        <lineIndentProvider implementation="com.zigrawr.jbplugin.indent.ZigLineIndentProvider"/>
        <enterBetweenBracesDelegate
            language="Zig"
            implementationClass="com.zigrawr.jbplugin.indent.ZigEnterBetweenBracesDelegate"/>
        <lang.parserDefinition
            language="Zig"
            implementationClass="com.zigrawr.jbplugin.lexer.ZigParserDefinition"/>
        <lang.syntaxHighlighterFactory
            language="Zig"
            implementationClass="com.zigrawr.jbplugin.highlight.ZigSyntaxHighlighterFactory"/>
        <fileType
            name="Zig"
            language="Zig"
            extensions="zig"
            implementationClass="com.zigrawr.jbplugin.file.ZigFileType"
            fieldName="INSTANCE"/>
        <fileType
            name="Zon"
            language="Zon"
            extensions="zon"
            implementationClass="com.zigrawr.jbplugin.file.ZonFileType"
            fieldName="INSTANCE"/>
    </extensions>
</idea-plugin>
