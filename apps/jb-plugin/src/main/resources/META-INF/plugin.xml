<idea-plugin>
    <id>com.varlanv.zigrawr</id>
    <name>ZigRawr</name>
    <vendor>varlanv</vendor>
    <description>Zig language support. todotofill40charsrequirement</description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <extensions defaultExtensionNs="com.intellij">
        <lineIndentProvider implementation="com.zigrawr.jbplugin.indent.ZigLineIndentProvider"/>
        <enterBetweenBracesDelegate
            language="Zig"
            implementation="com.zigrawr.jbplugin.indent.ZigEnterBetweenBracesDelegate"/>
        <lang.parserDefinition
            language="Zig"
            implementationClass="com.zigrawr.jbplugin.lexer.ZigParserDefinition"/>
        <lang.syntaxHighlighterFactory
            language="Zig"
            implementationClass="com.zigrawr.jbplugin.highlight.ZigSyntaxHighlighterFactory"/>
        <fileType
            name="Zig"
            language="Zig"
            extensions="zig"
            implementationClass="com.zigrawr.jbplugin.file.ZigFileType"
            fieldName="INSTANCE"/>
        <fileType
            name="Zon"
            language="Zon"
            extensions="zon"
            implementationClass="com.zigrawr.jbplugin.file.ZonFileType"
            fieldName="INSTANCE"/>
    </extensions>
</idea-plugin>
